<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marvel Avengers</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Navigation Bar -->
    <nav>
        <h1>MARVEL</h1>

        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#heroes">Heroes</a></li>
            <li><a href="#movies">Movies</a></li>
            <li><a href="stories.html">Stories</a></li>
            <li><a href="timeline.html">Timeline</a></li>
            <li><a href="assemble.html">Assemble</a></li>
        </ul>
    </nav>


    <!-- Home Section -->
    <section id="home" class="hero">
        <div class="hero-content">
            <h2>THE AVENGERS</h2>

            <p>
                Earth's Mightiest Heroes
            </p>

            <a href="#heroes" class="button">
                Meet The Avengers
            </a>
        </div>
    </section>


    <!-- Heroes Section -->
    <section id="heroes">

        <h2 class="section-title">AVENGERS</h2>

        <div class="cards">

            <div class="card">
               <img src="images/captain.jpg" alt="Captain America">
                <h3>Captain America</h3>
                <p>
                    Steve Rogers is a super soldier and one of
                    the greatest leaders of the Avengers.
                </p>
            </div>


            <div class="card">
                <img src="images/thor.jpg" alt="Thor">
                <h3>Thor</h3>
                <p>
                    Thor is the God of Thunder and a powerful
                    member of the Avengers.
                </p>
            </div>


            <div class="card">
                <img src="images/ironman.jpg" alt="Iron Man">
                <h3>Iron Man</h3>
                <p>
                    Tony Stark is a genius inventor who fights
                    using his advanced Iron Man suit.
                </p>
            </div>


            <div class="card">
                <img src="images/hulk.jpg" alt="Hulk">
                <h3>Hulk</h3>
                <p>
                    Bruce Banner transforms into the incredibly
                    powerful Hulk.
                </p>
            </div>

        </div>

    </section>


    <!-- Movies Section -->
    <section id="movies">

        <h2 class="section-title">AVENGERS MOVIES</h2>

        <div class="movie-container">

            <div class="movie">
                <img src="images/avengers2012.jpg" alt="The Avengers">
                <h3>The Avengers</h3>
                <p>2012</p>
            </div>

            <div class="movie">
                 <img src="images/age of ultron.jpg" alt="Avengers Age of Ultron">
                <h3>Avengers: Age of Ultron</h3>
                <p>2015</p>
            </div>

            <div class="movie">
                 <img src="images/war.jpg" alt="Avengers Infinity War">
                <h3>Avengers: Infinity War</h3>
                <p>2018</p>
            </div>

            <div class="movie">
                 <img src="images/endgame.jpg" alt="Avengers Endgame">
                <h3>Avengers: Endgame</h3>
                <p>2019</p>
            </div>

        </div>

    </section>


    <!-- Footer -->
    <footer>
        <p>© 2026 Marvel Avengers Project</p>
    </footer>

</body>
</html>
